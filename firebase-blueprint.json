{
  "entities": {
    "userProfile": {
      "title": "UserProfile",
      "description": "Information about registered app users",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "format": "email", "description": "User email address" },
        "displayName": { "type": "string", "maxLength": 100, "description": "User display name" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Profile creation timestamp" }
      },
      "required": ["uid", "email"]
    },
    "task": {
      "title": "Task",
      "description": "User task item",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": "string", "maxLength": 1000 },
        "priority": { "type": "string", "enum": ["alta", "media", "baja"] },
        "category": { "type": "string", "maxLength": 50 },
        "dueDate": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "enum": ["pendiente", "en_proceso", "completada"] },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["userId", "title", "status"]
    },
    "note": {
      "title": "Note",
      "description": "User note document",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "content": { "type": "string", "maxLength": 5000 },
        "category": { "type": "string", "maxLength": 50 },
        "pinned": { "type": "boolean" },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["userId", "title", "content"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "userProfile",
      "description": "User profile document"
    },
    "/users/{userId}/tasks/{taskId}": {
      "schema": "task",
      "description": "User specific tasks collection"
    },
    "/users/{userId}/notes/{noteId}": {
      "schema": "note",
      "description": "User specific notes collection"
    }
  }
}
